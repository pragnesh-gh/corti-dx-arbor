# Corti Agent API credentials (the LLM + expert backbone).
# Copy from /Users/pkp/Desktop/Work/agent-eval-cases/.env
#
# Region selection: set CORTI_REGION to dev-weu (default), eu, staging-eu, us,
# or local. The client reads AGENT_API_URL_<REGION>, AGENT_API_AUTH_URL_<REGION>,
# AGENT_API_CLIENT_ID_<REGION>, AGENT_API_CLIENT_SECRET_<REGION>.
#
# NOTE (2026-08-23): dev-weu's /a2a/message:send returns a plain-text
# `404 page not found` (route not routed on that deployment) even though agent
# CRUD works there. eu and staging-eu serve the A2A route (HTTP 200) but the
# tenant accounts there have insufficient credits. Until dev-weu's A2A route
# is fixed OR a credited account is available, the live end-to-end smoke
# cannot produce model output. Typecheck/build/registry-probe remain green.
CORTI_REGION=dev-weu
AGENT_API_URL_DEV_WEU=https://api.dev-weu.corti.app
AGENT_API_AUTH_URL_DEV_WEU=https://auth.dev-weu.corti.app
AGENT_API_CLIENT_ID_DEV_WEU=
AGENT_API_CLIENT_SECRET_DEV_WEU=
# EU (fixed URLs, per the eval harness):
AGENT_API_URL_EU=https://api.eu.corti.app
AGENT_API_AUTH_URL_EU=https://auth.eu.corti.app
AGENT_API_CLIENT_ID_EU=
AGENT_API_CLIENT_SECRET_EU=
# staging-eu / us analogous.
CORTI_TENANT_NAME=base

# Optional: PubMed & web-search experts may use these tokens if configured.
PUBMED_TOKEN=
TAVILY_API_KEY=

# Server
PORT=8787
